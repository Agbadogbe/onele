APP_NAME="Onélé"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données -------------------------------------------------------
# SQLite par défaut : un simple fichier, aucun service à installer ni à
# démarrer. C'est ce qui rend l'installation identique sous Windows, macOS et
# Linux. Le fichier est créé par `php artisan onele:installer`.
# En laissant DB_DATABASE vide, Laravel utilise backend/database/database.sqlite
# — pas de chemin à écrire, donc pas de souci d'antislash sous Windows.
DB_CONNECTION=sqlite

# Pour travailler sur MySQL à la place, décommentez ce bloc, remplacez la ligne
# ci-dessus par DB_CONNECTION=mysql, créez la base puis relancez l'installateur :
#   mysql -u root -e "CREATE DATABASE onele CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
#   php artisan onele:installer --fresh
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=onele
# DB_USERNAME=root
# DB_PASSWORD=

# Sessions, cache et file d'attente sur fichier plutôt qu'en base : avec SQLite,
# un seul fichier sert déjà l'API et le serveur temps réel, et l'y ajouter le
# cache exposerait à des verrous d'écriture pour aucun bénéfice ici.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# Serveur WebSocket (php artisan reverb:start). Les identifiants ci-dessous
# sont des valeurs de démonstration : regénérez-les avec `php artisan reverb:install`.
REVERB_APP_ID=100000
REVERB_APP_KEY=onele-dev-key
REVERB_APP_SECRET=onele-dev-secret

# Adresse à laquelle les clients — et Laravel lui-même quand il publie —
# joignent Reverb. En 127.0.0.1 plutôt qu'en « localhost » : sous Windows,
# « localhost » se résout d'abord en ::1 alors que Reverb écoute en IPv4,
# et les diffusions échoueraient silencieusement.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Interface d'écoute du serveur. 0.0.0.0 pour qu'un téléphone du réseau local
# puisse s'y connecter ; à laisser tel quel pour un usage sur une seule machine.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
FILESYSTEM_DISK=local
# Les évènements de diffusion sont en `ShouldBroadcastNow` : aucun worker à
# lancer, donc aucune file d'attente à brancher.
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
